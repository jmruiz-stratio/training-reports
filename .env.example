# ─── Moodle (API REST) ───────────────────────────────────────────────────────
MOODLE_URL=https://tu-moodle.stratio.com
MOODLE_TOKEN=                         # token con acceso a las funciones §9.7 y §9.8

# ─── Stratio (API Rocket para subir a HDFS) ──────────────────────────────────
STRATIO_URL=https://admin.practices.stratio.com
STRATIO_USER=                         # usuario SSO (para login automático)
STRATIO_PASS=                         # contraseña SSO
STRATIO_TENANT=formacion

# ─── Cookies de Rocket (autenticación HDFS) ──────────────────────────────────
# Opción A: string completo generado por src/refresh_cookies.py (recomendado)
PRACTICES_COOKIES_FORMACION=

# Opción B: valores individuales (si los tienes de otra fuente)
# STRATIO_COOKIE=
# JSESSIONID=
#
# Si no defines ninguna de las opciones A/B, el agente intentará login automático
# con STRATIO_USER + STRATIO_PASS. Si también fallan, ejecuta:
#   python3 src/refresh_cookies.py

# ─── HDFS ────────────────────────────────────────────────────────────────────
HDFS_BASE_PATH=/informes/moodle

# ─── Agente ──────────────────────────────────────────────────────────────────
AGENT_WORKDIR=/tmp/moodle-reports-agent
AGENT_LOG_LEVEL=INFO
